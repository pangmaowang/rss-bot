# Copy this to .env and fill it in. .env is already gitignored; chmod 600 it too.
#
#   cp .env.example .env && chmod 600 .env && vi .env
#
# Not config.toml: that file is in git.
# For a one-off key, no edit needed: GRAB_API_KEY=sk-xxx rss --read --zh <URL>
#
# An OpenRouter key starts with sk-or-v1-. Set a spend cap on it in the dashboard,
# so a leak costs you that much and no more.
GRAB_API_KEY=
